---
import type { GetStaticPaths } from "astro";
import type { Inn, Section } from "../../../../../lib/types";
import { sectionStaticPaths } from "../../../../../data/inns";
import SectionPage from "../../../../../components/layout/SectionPage.astro";

export const getStaticPaths = (() =>
  sectionStaticPaths()) satisfies GetStaticPaths;

interface Props {
  inn: Inn;
  section: Section;
}

const { inn, section } = Astro.props;
---

<SectionPage inn={inn} lang="en" section={section} />
