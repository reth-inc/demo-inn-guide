---
interface Props {
  href: string;
  /** _blank で開くか */
  external?: boolean;
  variant?: "primary" | "secondary" | "ghost";
  class?: string;
}

const {
  href,
  external = false,
  variant = "secondary",
  class: className = "",
} = Astro.props;

const target = external ? "_blank" : undefined;
const rel = external ? "noopener noreferrer" : undefined;

const variantClass = {
  primary:
    "bg-[color:var(--color-accent-2)] text-white hover:bg-[color:var(--color-accent)] border border-transparent",
  secondary:
    "bg-[color:var(--color-surface)] text-[color:var(--color-ink)] hover:bg-[color:var(--color-surface-2)] border border-[color:var(--color-border)]",
  ghost:
    "bg-transparent text-[color:var(--color-accent-2)] hover:bg-[color:var(--color-accent-soft)] border border-transparent",
}[variant];
---

<a
  href={href}
  target={target}
  rel={rel}
  class={`tap inline-flex items-center justify-center gap-1.5 rounded-xl px-4 py-2 text-sm font-medium transition-colors ${variantClass} ${className}`}
>
  <slot />
</a>
