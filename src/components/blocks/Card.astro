---
interface Props {
  /** Tailwind の追加クラス */
  class?: string;
  /** padding を制御するか（false にすると padding 0） */
  padded?: boolean;
}

const { class: className = "", padded = true } = Astro.props;
---

<article
  class={`rounded-2xl bg-[color:var(--color-surface)] border border-[color:var(--color-border)] shadow-[0_1px_2px_rgba(0,0,0,0.03)] ${
    padded ? "p-4 sm:p-5" : ""
  } ${className}`}
>
  <slot />
</article>
