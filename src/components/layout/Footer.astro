---
import type { Inn, Lang } from "../../lib/types";
import { dict } from "../../lib/i18n";
import { nonEmpty, pickText } from "../../lib/helpers";

interface Props {
  inn: Inn;
  lang: Lang;
}

const { inn, lang } = Astro.props;
const d = dict(lang);
const f = inn.footer;
const address = pickText(lang, f.addressJa, f.addressEn, f.addressZh);
---

<footer
  class="mt-12 border-t border-[color:var(--color-border)] bg-[color:var(--color-surface-2)]"
>
  <div class="mx-auto max-w-screen-md space-y-6 px-4 py-8">
    <h2
      class="text-sm font-semibold tracking-wider text-[color:var(--color-ink-2)] uppercase"
    >
      {d.sections.contact}
    </h2>

    <dl class="grid grid-cols-1 gap-4 text-sm">
      <div>
        <dt class="mb-1 text-xs text-[color:var(--color-muted)]">
          {d.footer.address}
        </dt>
        <dd class="leading-relaxed text-[color:var(--color-ink)]">{address}</dd>
      </div>
      {
        nonEmpty(f.phone) && (
          <div>
            <dt class="mb-1 text-xs text-[color:var(--color-muted)]">
              {d.footer.phone}
            </dt>
            <dd>
              <a
                href={`tel:${f.phone.replace(/[^0-9+]/g, "")}`}
                class="text-[color:var(--color-accent-2)] underline underline-offset-2 hover:opacity-80"
              >
                {f.phone}
              </a>
            </dd>
          </div>
        )
      }
      {
        nonEmpty(f.email) && (
          <div>
            <dt class="mb-1 text-xs text-[color:var(--color-muted)]">
              {d.footer.email}
            </dt>
            <dd>
              <a
                href={`mailto:${f.email}`}
                class="break-all text-[color:var(--color-accent-2)] underline underline-offset-2 hover:opacity-80"
              >
                {f.email}
              </a>
            </dd>
          </div>
        )
      }
    </dl>

    <div class="flex flex-wrap gap-2 pt-2">
      {
        nonEmpty(f.instagramUrl) && (
          <a
            href={f.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={d.actions.openInstagram}
            class="tap inline-flex size-11 items-center justify-center rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] text-[color:var(--color-ink-2)] hover:bg-[color:var(--color-surface-2)]"
          >
            <svg
              viewBox="0 0 24 24"
              class="size-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
            </svg>
          </a>
        )
      }
      {
        nonEmpty(f.lineUrl) && (
          <a
            href={f.lineUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={d.actions.openLine}
            class="tap inline-flex size-11 items-center justify-center rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] text-[color:var(--color-ink-2)] hover:bg-[color:var(--color-surface-2)]"
          >
            <svg
              viewBox="0 0 24 24"
              class="size-5"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
</footer>
