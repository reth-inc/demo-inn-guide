---
import type { Section } from "../../lib/types";

interface Props {
  href: string;
  section: Section;
  title: string;
}

const { href, section, title } = Astro.props;

/**
 * セクションごとの簡易 SVG アイコン。
 * 単純な path 文字列の組み合わせで、外部依存を作らない。
 */
const iconMap: Record<Section, string> = {
  times: "M12 6v6l4 2 M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z",
  services:
    "M20 7h-3V5a3 3 0 0 0-3-3h-4a3 3 0 0 0-3 3v2H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2Zm-9-2a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2h-4Z",
  additional:
    "M9 20l-5.447-2.724A2 2 0 0 1 3 15.382V4.618a1 1 0 0 1 1.447-.894L9 6m0 14l6-3m-6 3V6m6 11l4.553 2.276A1 1 0 0 0 21 18.382V7.618a2 2 0 0 0-1.106-1.789L15 3m0 14V3m0 0L9 6",
  area: "M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z",
  faq: "M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9 8.5 8.5 0 0 1 8.5 8.5Z",
};
const iconPath = iconMap[section];
---

<a href={href} class="group block focus:outline-none">
  <article
    class="flex aspect-square flex-col items-center justify-center gap-3 rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-4 shadow-[0_1px_2px_rgba(0,0,0,0.03)] transition-colors group-hover:border-[color:var(--color-accent)] group-focus-visible:border-[color:var(--color-accent)]"
  >
    <span
      class="inline-flex size-12 items-center justify-center rounded-2xl bg-[color:var(--color-accent-soft)] text-[color:var(--color-accent-2)]"
      aria-hidden="true"
    >
      <svg
        viewBox="0 0 24 24"
        class="size-6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d={iconPath}></path>
      </svg>
    </span>
    <h3
      class="text-center text-sm leading-tight font-medium text-[color:var(--color-ink)] sm:text-base"
    >
      {title}
    </h3>
  </article>
</a>
