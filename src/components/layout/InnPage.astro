---
import type { Inn, Lang } from '../../lib/types';
import { SECTIONS } from '../../lib/types';
import { dict } from '../../lib/i18n';
import { altLangPath, sectionPath } from '../../lib/helpers';
import { hasSectionContent } from '../../data/inns';
import BaseLayout from './BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import WifiSection from '../sections/WifiSection.astro';
import InfoSection from '../sections/InfoSection.astro';
import SectionLinkCard from './SectionLinkCard.astro';

interface Props {
  inn: Inn;
  lang: Lang;
}

const { inn, lang } = Astro.props;
const d = dict(lang);

const innName =
  lang === 'en' ? inn.header.nameEn || inn.header.nameJa : inn.header.nameJa;

const pageTitle = `${innName} | ${d.siteName}`;
const pageDesc =
  lang === 'en' ? `In-house guide for ${innName}` : `${innName} の館内案内`;

const altHref = altLangPath(inn.slug, lang);

const hasInfo = inn.info.some((it) => it.isVisible);

// 表示すべきセクションのみリンクとして列挙する
const visibleSections = SECTIONS.filter((s) => hasSectionContent(inn, s));
---

<BaseLayout title={pageTitle} description={pageDesc} lang={lang}>
  <Header inn={inn} lang={lang} altHref={altHref} />

  <main class="pb-8">
    {/* Wi-Fi（デフォルト背景） */}
    <div class="mx-auto max-w-screen-md pt-6">
      <WifiSection wifi={inn.wifi} lang={lang} />
    </div>

    {/* セクション導線カード（背景色を変えてバンド表示） */}
    {visibleSections.length > 0 && (
      <div class="mt-6 bg-[color:var(--color-surface-2)] py-6 sm:py-8">
        <div class="mx-auto max-w-screen-md">
          <ul class="grid grid-cols-2 gap-3 px-4 sm:px-0">
            {visibleSections.map((s) => (
              <li>
                <SectionLinkCard
                  href={sectionPath(inn.slug, s, lang)}
                  section={s}
                  title={d.sections[s]}
                />
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}

    {/* インフォメーション（デフォルト背景に戻す） */}
    {hasInfo && (
      <section class="mx-auto max-w-screen-md mt-8">
        <header class="mb-4 px-4 sm:px-0">
          <h3 class="text-xl sm:text-2xl font-semibold text-[color:var(--color-ink)] leading-tight">
            {lang === 'en' ? 'Information' : 'インフォメーション'}
          </h3>
        </header>
        <InfoSection items={inn.info} lang={lang} showTitle={false} />
      </section>
    )}
  </main>

  <Footer inn={inn} lang={lang} />
</BaseLayout>
