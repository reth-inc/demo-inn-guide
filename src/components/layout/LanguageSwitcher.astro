---
import type { Lang } from '../../lib/types';
import type { LangLink } from '../../lib/helpers';
import { dict } from '../../lib/i18n';

interface Props {
  /** 現在の言語 */
  current: Lang;
  /** 全言語へのリンク（現在の言語含む） */
  links: LangLink[];
}

const { current, links } = Astro.props;
const d = dict(current);
---

<nav
  class="inline-flex items-center gap-1 rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-0.5 text-xs font-medium"
  aria-label={d.langLabel}
>
  {
    links.map((l) => (
      <a
        href={l.href}
        aria-current={l.isCurrent ? 'page' : undefined}
        class:list={[
          'tap inline-flex items-center justify-center rounded-full px-2.5 py-1 transition-colors',
          l.isCurrent
            ? 'bg-[color:var(--color-accent-2)] text-white'
            : 'text-[color:var(--color-ink-2)] hover:bg-[color:var(--color-surface-2)]',
        ]}
      >
        {l.label}
      </a>
    ))
  }
</nav>
