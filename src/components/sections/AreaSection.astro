---
import type { AreaItem, Lang } from "../../lib/types";
import { dict } from "../../lib/i18n";
import { nonEmpty, pickText, visibleSorted } from "../../lib/helpers";
import SectionTitle from "../common/SectionTitle.astro";
import Card from "../blocks/Card.astro";
import Badge from "../blocks/Badge.astro";
import Button from "../blocks/Button.astro";

interface Props {
  items: AreaItem[];
  lang: Lang;
  showTitle?: boolean;
}

const { items, lang, showTitle = true } = Astro.props;
const d = dict(lang);
const visible = visibleSorted(items);
---

{
  visible.length > 0 && (
    <section class="px-4 sm:px-0">
      {showTitle && <SectionTitle title={d.sections.area} eyebrow="AROUND" />}

      <ul class="grid grid-cols-1 gap-3">
        {visible.map((item) => {
          const title = pickText(
            lang,
            item.titleJa,
            item.titleEn,
            item.titleZh,
          );
          const body = pickText(lang, item.bodyJa, item.bodyEn, item.bodyZh);
          return (
            <li>
              <Card padded={false} class="overflow-hidden">
                {nonEmpty(item.imageUrl) && (
                  <div class="aspect-[16/9] bg-[color:var(--color-surface-2)]">
                    <img
                      src={item.imageUrl}
                      alt={title}
                      loading="lazy"
                      decoding="async"
                      class="block h-full w-full object-cover"
                    />
                  </div>
                )}
                <div class="p-4 sm:p-5">
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <h3 class="leading-tight font-medium text-[color:var(--color-ink)]">
                      {title}
                    </h3>
                    {item.tags.length > 0 && (
                      <ul class="flex flex-wrap gap-1.5">
                        {item.tags.map((tag) => (
                          <li>
                            <Badge tone="accent">{d.tags[tag]}</Badge>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                  {nonEmpty(body) && (
                    <p class="mt-2 text-sm leading-relaxed whitespace-pre-line text-[color:var(--color-ink-2)]">
                      {body}
                    </p>
                  )}
                  {nonEmpty(item.mapUrl) && (
                    <div class="mt-3">
                      <Button href={item.mapUrl} external variant="secondary">
                        <svg
                          viewBox="0 0 24 24"
                          class="size-4"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                          <circle cx="12" cy="10" r="3" />
                        </svg>
                        {d.actions.viewMap}
                      </Button>
                    </div>
                  )}
                </div>
              </Card>
            </li>
          );
        })}
      </ul>
    </section>
  )
}
