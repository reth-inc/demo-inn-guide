---
import type { FaqItem, Lang } from '../../lib/types';
import { dict } from '../../lib/i18n';
import { pickText, visibleSorted } from '../../lib/helpers';
import SectionTitle from '../common/SectionTitle.astro';
import Card from '../blocks/Card.astro';

/**
 * FAQ アコーディオン。<details>/<summary> ベースなので JS 不要。
 */
interface Props {
  items: FaqItem[];
  lang: Lang;
  showTitle?: boolean;
}

const { items, lang, showTitle = true } = Astro.props;
const d = dict(lang);
const visible = visibleSorted(items);
---

{visible.length > 0 && (
  <section class="px-4 sm:px-0">
    {showTitle && <SectionTitle title={d.sections.faq} eyebrow="FAQ" />}

    <Card padded={false}>
      <ul class="divide-y divide-[color:var(--color-border)]">
        {visible.map((item) => {
          const q = pickText(lang, item.questionJa, item.questionEn);
          const a = pickText(lang, item.answerJa, item.answerEn);
          return (
            <li>
              <details class="group">
                <summary class="flex items-start gap-3 p-4 sm:p-5 hover:bg-[color:var(--color-surface-2)]/60">
                  <span
                    class="inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-accent-soft)] text-[color:var(--color-accent-2)] text-[11px] font-semibold tracking-wide"
                    aria-hidden="true"
                  >
                    {d.faq.questionLabel}
                  </span>
                  <span class="flex-1 text-sm font-medium text-[color:var(--color-ink)] leading-snug">
                    {q}
                  </span>
                  <svg
                    class="faq-chevron mt-1 size-4 shrink-0 text-[color:var(--color-muted)]"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="6 9 12 15 18 9" />
                  </svg>
                </summary>
                <div class="px-4 sm:px-5 pb-4 sm:pb-5 pl-[3.25rem] -mt-1">
                  <p class="text-sm text-[color:var(--color-ink-2)] leading-relaxed whitespace-pre-line">
                    {a}
                  </p>
                </div>
              </details>
            </li>
          );
        })}
      </ul>
    </Card>
  </section>
)}
