---
interface Props {
  id?: string;
  title: string;
  subtitle?: string;
  /** セクションラベル（任意・小さく表示する英字 or 略称） */
  eyebrow?: string;
}

const { id, title, subtitle, eyebrow } = Astro.props;
---

<header class="mb-4" id={id}>
  {eyebrow && (
    <p class="text-[11px] tracking-[0.18em] font-medium text-[color:var(--color-accent-2)] uppercase mb-1">
      {eyebrow}
    </p>
  )}
  <h2 class="text-xl sm:text-2xl font-semibold text-[color:var(--color-ink)] leading-tight">
    {title}
  </h2>
  {subtitle && (
    <p class="mt-1 text-sm text-[color:var(--color-ink-2)] leading-relaxed">
      {subtitle}
    </p>
  )}
</header>
