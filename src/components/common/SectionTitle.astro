---
interface Props {
  id?: string;
  title: string;
  subtitle?: string;
  /** セクションラベル（任意・小さく表示する英字 or 略称） */
  eyebrow?: string;
}

const { id, title, subtitle, eyebrow } = Astro.props;
---

<header class="mb-4" id={id}>
  {
    eyebrow && (
      <p class="mb-1 text-[11px] font-medium tracking-[0.18em] text-[color:var(--color-accent-2)] uppercase">
        {eyebrow}
      </p>
    )
  }
  <h2
    class="text-xl leading-tight font-semibold text-[color:var(--color-ink)] sm:text-2xl"
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class="mt-1 text-sm leading-relaxed text-[color:var(--color-ink-2)]">
        {subtitle}
      </p>
    )
  }
</header>
